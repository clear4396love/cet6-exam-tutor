  "parsing_res_list": [
    {
      "block_label": "text",
      "block_content": "It’s possible that the lower amount of agreement in the shared taste of artifacts has to do more with elements of style, rather than “behavioral consequences”.",
      "block_bbox": [
        67,
        77,
        1121,
        133
      ],
      "block_id": 0,
      "block_order": 1,
      "group_id": 0,
      "block_polygon_points": [
        [
          67.0,
