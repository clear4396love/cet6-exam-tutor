        ],
        [
          561.0,
          638.0
        ],
        [
          561.0,
          789.0
        ],
        [
          69.0,
          789.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "48. What does the author think of rich urban residents buying a second home in the countryside?\nA) It is bound to mar the traditional rural life.\nB) It adversely impacts rural social stability.\nC) It hinders rural economies' revitalisation.\nD) It is detrimental to rural preservation.",
      "block_bbox": [
        69,
        794,
        885,
        945
      ],
      "block_id": 6,
      "block_order": 7,
      "group_id": 6,
      "block_polygon_points": [
