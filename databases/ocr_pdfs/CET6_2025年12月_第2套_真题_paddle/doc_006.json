          944.0,
          765.0
        ],
        [
          944.0,
          851.0
        ],
        [
          67.0,
          851.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "53. What is the advice receiver tempted to do when noticing the advice giver's underlying anxiety?\nA) Reveal the undesirable result of their approach. C) Bring their real motives to the surface.\nB) Refuse their advice in an undisguised manner. D) Accuse them of trying to control others.",
      "block_bbox": [
        68,
        856,
        940,
        945
      ],
      "block_id": 8,
      "block_order": 9,
      "group_id": 8,
