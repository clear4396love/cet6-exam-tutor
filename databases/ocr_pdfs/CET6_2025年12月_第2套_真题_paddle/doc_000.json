          66.0,
          820.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "4. A) A complete refurbishing. C) A substantial expansion.\nB) A ruinous burning down. D) A massive renovation.",
      "block_bbox": [
        67,
        825,
        890,
        882
      ],
      "block_id": 15,
      "block_order": 16,
      "group_id": 15,
      "block_polygon_points": [
