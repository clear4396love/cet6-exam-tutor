        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "5. A) They have a poor work ethic. C) They are struggling in the workplace.\nB) They don't get along with managers. D) They aren't as varied as their predecessors.",
      "block_bbox": [
        67,
        951,
        1048,
        1006
      ],
      "block_id": 17,
      "block_order": 18,
      "group_id": 17,
      "block_polygon_points": [
