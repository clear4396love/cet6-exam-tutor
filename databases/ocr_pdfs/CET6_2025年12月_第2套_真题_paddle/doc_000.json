        [
          65.0,
          601.0
        ]
      ]
    },
    {
      "block_label": "paragraph_title",
      "block_content": "Questions 1 to 4 are based on the conversation you have just heard.",
      "block_bbox": [
        67,
        607,
        676,
        632
      ],
      "block_id": 11,
      "block_order": 12,
      "group_id": 11,
      "block_polygon_points": [
