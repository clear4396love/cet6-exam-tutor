          67.0,
          1006.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "6. A) Learning about the way they adhere to their own values.\nB) Recognizing how they try to strike a work-life balance.\nC) Knowing how they struggle to connect with managers.\nD) Understanding the way they seek career advancement.",
      "block_bbox": [
        69,
        1013,
        591,
        1131
      ],
      "block_id": 18,
      "block_order": 19,
      "group_id": 18,
