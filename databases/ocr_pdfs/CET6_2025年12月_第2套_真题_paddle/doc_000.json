        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "1. A) It is absurdly expensive. B) It is appropriately priced. C) It brings shame on the university. D) It caters to students and teachers.",
      "block_bbox": [
        69,
        637,
        971,
        693
      ],
      "block_id": 12,
      "block_order": 13,
      "group_id": 12,
      "block_polygon_points": [
        [
          69.0,
          637.0
        ],
        [
          971.0,
          637.0
        ],
        [
          971.0,
          693.0
        ],
        [
          69.0,
          693.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "2. A) They never really appeal to her. C) They are within students' budgets.\nB) They are never actually good value. D) They always come at a high speed.",
      "block_bbox": [
        67,
        701,
        982,
        758
      ],
      "block_id": 13,
      "block_order": 14,
      "group_id": 13,
      "block_polygon_points": [
        [
          67.0,
          701.0
        ],
        [
          982.0,
          701.0
        ],
        [
          982.0,
          758.0
        ],
        [
          67.0,
          758.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "3. A) The food. C) The speed.\nB) The space. D) The environment.",
      "block_bbox": [
        66,
        763,
        839,
        820
      ],
      "block_id": 14,
      "block_order": 15,
      "group_id": 14,
      "block_polygon_points": [
        [
          66.0,
