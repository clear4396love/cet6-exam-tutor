        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "L) There is a growing global momentum around forgotten foods, says Danielle Nierenberg, president of Food Tank, a US-based think tank. Other than CFF, which bills itself as the world's first research centre dedicated solely to under-utilised crops, there are other key groups championing agricultural diversity including Crop Trust, Slow Food, Icrisat and Bioversity International. Add to that more middle-income consumers searching for nutritious foods and others eager to try the unprocessed foods their grandparents once ate, she says.",
      "block_bbox": [
        67,
        359,
        1123,
        508
      ],
      "block_id": 2,
      "block_order": 3,
      "group_id": 2,
      "block_polygon_points": [
        [
          67.0,
