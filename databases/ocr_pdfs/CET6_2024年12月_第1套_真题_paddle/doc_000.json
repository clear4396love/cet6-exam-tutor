        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "4. A) To avoid offending the recipients. C) To save time.\nB) To show her unique writing style. D) To be frank.",
      "block_bbox": [
        67,
        950,
        800,
        1007
      ],
