        [
          70.0,
          756.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "2. A) The overall culture of the company. C) The honesty of the manager.\nB) The instruction from her supervisor. D) The recognition of her merits.",
      "block_bbox": [
        67,
        761,
        939,
        820
      ],
      "block_id": 13,
      "block_order": 14,
      "group_id": 13,
      "block_polygon_points": [
