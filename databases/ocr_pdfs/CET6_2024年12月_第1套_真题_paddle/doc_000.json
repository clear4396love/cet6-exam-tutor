    {
      "block_label": "text",
      "block_content": "1. A) Preparing for a job interview.\nB) Writing a work report together.\nC) Going through a couple of issues the company faces.\nD) Discussing the woman's annual performance review.",
      "block_bbox": [
        70,
        638,
        567,
        756
      ],
      "block_id": 12,
      "block_order": 13,
      "group_id": 12,
      "block_polygon_points": [
