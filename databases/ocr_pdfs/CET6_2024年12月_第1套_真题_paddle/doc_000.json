        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "3. A) Her inadequate language proficiency.\nB) Her inability to interact with colleagues properly.\nC) Her inappropriate behavior at company meetings.\nD) Her simplistic approach to dealing with others.",
      "block_bbox": [
        69,
        825,
        543,
        944
      ],
      "block_id": 14,
      "block_order": 15,
      "group_id": 14,
