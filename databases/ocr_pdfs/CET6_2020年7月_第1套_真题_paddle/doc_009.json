    {
      "block_label": "text",
      "block_content": "Questions 51 to 55 are based on the following passage.",
      "block_bbox": [
        174,
        179,
        735,
        206
      ],
      "block_id": 1,
      "block_order": 2,
      "group_id": 1,
      "block_polygon_points": [
