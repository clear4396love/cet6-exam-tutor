        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "A) Some predators may often turn out to be prey of other predators.",
      "block_bbox": [
        221,
        1397,
        882,
        1423
      ],
      "block_id": 10,
      "block_order": 11,
