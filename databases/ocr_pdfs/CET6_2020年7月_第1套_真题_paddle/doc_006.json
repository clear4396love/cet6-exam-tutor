    {
      "block_label": "text",
      "block_content": "[I] In the 1980s, these kinds of implicit measures became customary in developmental psychology. But it took a while longer before these tools were employed to measure children's grasp of the mental lives of others.",
      "block_bbox": [
        173,
        212,
        1018,
        301
      ],
      "block_id": 1,
      "block_order": 2,
      "group_id": 1,
      "block_polygon_points": [
        [
          173.0,
