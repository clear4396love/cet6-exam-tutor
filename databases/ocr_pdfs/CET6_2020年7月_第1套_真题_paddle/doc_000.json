    },
    {
      "block_label": "text",
      "block_content": "1. A) She is a great athlete.\nB) She is a famed speaker.\nC) She is a famous scientist.\nD) She is a noted inventor.",
      "block_bbox": [
        214,
        679,
        501,
        796
      ],
      "block_id": 7,
      "block_order": 8,
      "group_id": 7,
      "block_polygon_points": [
        [
          214.0,
