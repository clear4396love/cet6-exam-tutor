        ],
        [
          222.0,
          923.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "3. A) Our physical structures.\nB) Our scientific knowledge.\nC) Our biochemical process.\nD) Our concept of nutrition.",
      "block_bbox": [
        224,
        929,
        511,
        1048
      ],
      "block_id": 9,
      "block_order": 10,
      "group_id": 9,
      "block_polygon_points": [
