    {
      "block_label": "text",
      "block_content": "Directions: In this section, you will hear two long conversations. At the end of each conversation, you will hear four questions. Both the conversation and the questions will be spoken only once. After you hear a question, you must choose the best answer from the four choices marked A), B), C) and D). Then mark the corresponding letter on Answer Sheet 1 with a single line through the centre.",
      "block_bbox": [
        174,
        429,
        1018,
        614
      ],
      "block_id": 5,
      "block_order": 6,
      "group_id": 5,
      "block_polygon_points": [
