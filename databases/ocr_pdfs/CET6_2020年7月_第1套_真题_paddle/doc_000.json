          174.0,
          614.0
        ]
      ]
    },
    {
      "block_label": "paragraph_title",
      "block_content": "Questions 1 to 4 are based on the conversation you have just heard.",
      "block_bbox": [
        174,
        646,
        870,
        674
      ],
      "block_id": 6,
