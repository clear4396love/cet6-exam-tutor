        ],
        [
          501.0,
          679.0
        ],
        [
          501.0,
          796.0
        ],
        [
          214.0,
          796.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "2. A) How knowledge of human biochemistry has been evolving\nB) How nutrition helps athletes' performance in competitions.\nC) How scientific training enables athletes to set new records.\nD) How technology has helped athletes to scale new heights.",
      "block_bbox": [
        222,
        803,
        851,
        923
      ],
      "block_id": 8,
      "block_order": 9,
      "group_id": 8,
      "block_polygon_points": [
        [
          222.0,
