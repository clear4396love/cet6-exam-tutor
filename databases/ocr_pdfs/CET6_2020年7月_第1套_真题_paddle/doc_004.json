    {
      "block_label": "paragraph_title",
      "block_content": "Children Understand Far More About Other Minds Than Long Believed",
      "block_bbox": [
        173,
        927,
        928,
        955
      ],
      "block_id": 3,
      "block_order": 4,
      "group_id": 3,
      "block_polygon_points": [
