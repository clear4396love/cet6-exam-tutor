          173.0,
          394.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "43. The newer research methods focus on infants' simple behaviors instead of requiring them to answer questions.",
      "block_bbox": [
        174,
        398,
        1018,
        456
      ],
      "block_id": 4,
      "block_order": 5,
      "group_id": 4,
      "block_polygon_points": [
        [
          174.0,
