          1016.0,
          330.0
        ],
        [
          173.0,
          330.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "42. Scientists are still debating what inference can be drawn from certain physical expressions of a child.",
      "block_bbox": [
        173,
        335,
        1017,
        394
      ],
      "block_id": 3,
      "block_order": 4,
      "group_id": 3,
      "block_polygon_points": [
