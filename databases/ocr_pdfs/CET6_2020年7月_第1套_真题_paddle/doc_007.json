        ],
        [
          174.0,
          268.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "41. It has been found in recent research that even small babies are sensitive to other people's points of view.",
      "block_bbox": [
        173,
        273,
        1016,
        330
      ],
      "block_id": 2,
      "block_order": 3,
      "group_id": 2,
      "block_polygon_points": [
        [
          173.0,
          273.0
        ],
        [
          1016.0,
          273.0
        ],
