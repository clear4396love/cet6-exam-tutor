        ],
        [
          174.0,
          456.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "44. With the progress in psychology, the traditional view of children's self-centered nature and limited thinking abilities has become less and less influential.",
      "block_bbox": [
        173,
        460,
        1017,
        517
      ],
      "block_id": 5,
      "block_order": 6,
      "group_id": 5,
      "block_polygon_points": [
