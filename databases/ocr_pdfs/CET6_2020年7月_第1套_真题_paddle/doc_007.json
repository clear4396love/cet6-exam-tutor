      "block_label": "text",
      "block_content": "39. Research conducted by Jean Piaget in the last century suggested babies were insensitive to others\" thinking.",
      "block_bbox": [
        174,
        148,
        1017,
        206
      ],
      "block_id": 0,
      "block_order": 1,
      "group_id": 0,
