        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "40. Our improved understanding of babies' intellectual power is attributable to better research tools.",
      "block_bbox": [
        174,
        211,
        1018,
        268
      ],
      "block_id": 1,
      "block_order": 2,
      "group_id": 1,
      "block_polygon_points": [
        [
          174.0,
