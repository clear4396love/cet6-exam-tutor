.pytest-tmp/
.docx_qa/
tmp/
t.db/
milvus_verify.db/

# 真题原卷、OCR 中间产物与人工核对缓存只留本机；公开仓库只放格式说明。
databases/
parsed_papers/**
!parsed_papers/README.md
translation_audit.md
tests/test_corpus_integrity.py
tests/test_section_a_ocr.py

